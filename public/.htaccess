# Apache Configuration for Demi Tech Solutions (cPanel / public_html)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # If requested resource exists as a file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never rewrite asset requests (js, css, images, fonts) to index.html to prevent MIME-type errors
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|jpg|jpeg|png|gif|svg|ico|webp|woff|woff2|ttf|eot|json)$ [NC]
  RewriteRule ^ - [L]

  # Route all other URLs to index.html for Single Page Application routing
  RewriteRule ^ index.html [L]
</IfModule>

# Force correct MIME types for JavaScript and CSS modules
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>

# Allow CORS for module scripts
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
</IfModule>
