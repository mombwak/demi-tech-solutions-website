# ==============================================================================
# Demi Tech Solutions – High Performance cPanel / Apache Configuration
# ==============================================================================

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Direct file / directory requests: serve as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route direct public_html_deployment alias to the zip package
  RewriteRule ^public_html_deployment/?$ public_html_deployment.zip [L]

  # Route M-Pesa API endpoints to PHP handlers in cPanel environments
  RewriteRule ^api/mpesa/config-status/?$ api/mpesa/config-status.php [L,QSA]
  RewriteRule ^api/mpesa/stkpush/?$ api/mpesa/stkpush.php [L,QSA]
  RewriteRule ^api/mpesa/status/([^/]+)/?$ api/mpesa/status.php?id=$1 [L,QSA]
  RewriteRule ^api/mpesa/status/?$ api/mpesa/status.php [L,QSA]
  RewriteRule ^api/mpesa/simulate-action/?$ api/mpesa/simulate-action.php [L,QSA]
  RewriteRule ^api/mpesa/temporary-credentials/?$ api/mpesa/temporary-credentials.php [L,QSA]

  # Prevent API routes from ever falling back to index.html (eliminates JSON parse errors)
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [R=404,L]

  # Never rewrite asset files to index.html (prevents MIME-type mismatch on missing assets)
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|jpg|jpeg|png|gif|svg|ico|webp|woff|woff2|ttf|eot|json|xml|txt|zip|php)$ [NC]
  RewriteRule ^ - [L]

  # Route all other URLs to index.html for Single Page Application client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# Force Correct MIME Types
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType application/json .json
  AddType application/zip .zip
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Gzip / Deflate Compression for Lightning-Fast Loading Speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/eot
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# Mod Expires for PageSpeed Insights High Cache Efficiency
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/zip "access plus 0 seconds"
</IfModule>

# Caching Rules: Never cache index.html (guarantees newest code is always loaded)
# Cache hashed assets aggressively (1 year)
<IfModule mod_headers.c>
  # CORS header for ES module compatibility across subdomains/CDNs
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization"

  # Prevent stale index.html from freezing browser on old bundle hashes
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache static hashed assets for 1 year with immutable tag
  <FilesMatch "\.(js|mjs|css|woff2|woff|ttf|png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Do not cache deployment package archive
  <FilesMatch "\.(zip)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
